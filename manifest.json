{
  "manifest_version": 3,
  "name": "Passwordmanager-extension",
  "version": "1.0",
  "description": "",
  "icons": {
    "48": "icons/icon-48.png"
  },
  "permissions": [
    "userScripts",
    "activeTab",
    "*://localhost:*/*"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "browser_action": {
    "default_icon": "icons/icon-48.png",
    "default_title": "Passwordmanager-extension"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "script.js"
      ],
      "run_at": "document_end"
    }
  ]
}
